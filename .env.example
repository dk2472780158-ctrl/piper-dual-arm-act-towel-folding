# ------------------------------------------------------------------
# piper-dual-arm-act-towel-folding — environment template
# Copy to `.env` and fill in values for YOUR machine. `.env` is git-ignored.
# ------------------------------------------------------------------

# --- CAN bus ---
ROBOT_LEFT_CAN=can1
ROBOT_RIGHT_CAN=can0

# --- Cameras (OpenCV backend, addressed by stable udev symlinks) ---
# Create symlinks on your host, e.g.:
#   sudo ln -s /dev/video6  /dev/camera_left
#   sudo ln -s /dev/video16 /dev/camera_middle
#   sudo ln -s /dev/video23 /dev/camera_right
CAMERA_LEFT=/dev/camera_left
CAMERA_MIDDLE=/dev/camera_middle
CAMERA_RIGHT=/dev/camera_right
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30

# --- Control loop ---
CONTROL_FPS=30

# --- Policy server / client ---
SERVER_ADDRESS=127.0.0.1:8082
POLICY_TYPE=act
# Point this at a LeRobot-format `pretrained_model` directory (see README for download links).
POLICY_CHECKPOINT=<CHECKPOINT_PATH>
POLICY_DEVICE=cuda
CLIENT_DEVICE=cpu

# --- ACT action chunking at inference time ---
ACTIONS_PER_CHUNK=30          # actions executed per model invocation
CHUNK_SIZE_THRESHOLD=0.6      # client sends a new observation when action queue ≤ 60% full
AGGREGATE_FN=weighted_average # 0.3*old + 0.7*new blending of overlapping chunks

# --- Piper motor layer ---
# Optional first-order low-pass on the six arm joints (never the gripper).
# 1.0 = off. Keep 1.0 when using async weighted_average to avoid double smoothing.
PIPER_ACTION_FILTER_ALPHA=1.0

# --- Dataset (training) ---
DATASET_REPO_ID=local/towel_fold_dataset
DATASET_ROOT=<DATASET_ROOT>
DATA_FPS=30

# --- Task text ---
TASK_TEXT=Fold the towel with both Piper arms.
